/.agent-sandbox-config/
/.claude-sandbox-config/
/.codex-sandbox-config/
# Session-local Claude Code state (keep /.claude/skills/ tracked).
/.claude/settings.local.json
/.claude/*.lock
/.claude/scheduled_tasks.lock
/.claude/todos/
/.claude/history.jsonl
/analysis/
